# =====================================================================
#  MẪU CẤU HÌNH TOYLAND
#  Chép thành .env rồi điền giá trị thật. KHÔNG BAO GIỜ ghi khóa/mật khẩu
#  thật vào file mẫu này - nó được đưa lên GitHub.
#  Trên Render: khai các biến này ở tab Environment (xem render.yaml).
# =====================================================================

APP_NAME=ToyLand
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://toys_storee.test
# true trên Render (đứng sau proxy https)
FORCE_HTTPS=false

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- CSDL MySQL ---
# Máy nhà (Laragon): root, mật khẩu trống. Aiven: xem hướng dẫn triển khai.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=toyland
DB_USERNAME=root
DB_PASSWORD=
# Đường dẫn file CA khi kết nối Aiven (bỏ trống khi dùng MySQL trên máy)
MYSQL_ATTR_SSL_CA=

BROADCAST_DRIVER=log
# Trên Render dùng "database" cho cả hai để không mất phiên/giỏ hàng khi máy chủ ngủ
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Email ---
# Máy nhà: Gmail (smtp.gmail.com, 587, tls, Mật khẩu ứng dụng 16 ký tự)
# Render:  Brevo (smtp-relay.brevo.com, 2525, tls) - Render chặn cổng 587/465
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
MAIL_TIMEOUT=15

# --- Ảnh tải lên: Cloudinary (bỏ trống = lưu vào public/uploads) ---
# Dán chuỗi "API environment variable" trong Dashboard Cloudinary
CLOUDINARY_URL=
CLOUDINARY_FOLDER=toyland

# --- Tài khoản quản trị do seeder tạo ---
# Máy nhà bỏ trống mật khẩu = dùng Admin@123. Production BẮT BUỘC khai.
ADMIN_EMAIL=admin@tpcn.com
ADMIN_PASSWORD=
SEED_DEMO_CUSTOMERS=true

# --- Việc hằng ngày gọi qua /api/cron/daily (bỏ trống = tắt) ---
CRON_TOKEN=

# --- Thanh toán MoMo (sandbox) ---
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_REDIRECT_URL=
MOMO_IPN_URL=

# --- Giao hàng nhanh GHN (tùy chọn) ---
GHN_BASE_URL=
GHN_TOKEN=
GHN_SHOP_ID=
GHN_FROM_DISTRICT_ID=

# --- Đăng nhập Google (tùy chọn) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Chatbot: none | openai | gemini ---
CHATBOT_LLM_DRIVER=none
CHATBOT_LLM_KEY=
CHATBOT_LLM_MODEL=
